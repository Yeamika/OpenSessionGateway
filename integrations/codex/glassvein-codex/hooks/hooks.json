{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/pre-tool-use.mjs",
            "timeout": 5,
            "statusMessage": "Binding GlassVein MCP context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs",
            "timeout": 5,
            "statusMessage": "Loading GlassVein context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/stop.mjs",
            "timeout": 5,
            "statusMessage": "Updating GlassVein session state"
          }
        ]
      }
    ]
  }
}
