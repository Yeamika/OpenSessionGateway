{
  "name": "@opensessiongateway/opencode-vein-plugin",
  "version": "0.4.0",
  "description": "GlassVein opencode plugin — independent WS client for GlassVein router integration.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./entry": "./dist/entry.js",
    "./glassvein-router": "./dist/glassvein-router/index.js"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "pack:local": "npm pack"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "@opensessiongateway/osgp": "^0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "*",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.2"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=18"
  }
}
