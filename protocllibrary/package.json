{
  "name": "protocllibrary",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ws-contract/AbortSessionOfClient.js": ["dist/ws-contract/AbortSessionOfClient.d.ts"],
      "ws-contract/AddPromot.js": ["dist/ws-contract/AddPromot.d.ts"],
      "ws-contract/CurrentClient.js": ["dist/ws-contract/CurrentClient.d.ts"],
      "ws-contract/GetSessionMsg.js": ["dist/ws-contract/GetSessionMsg.d.ts"],
      "ws-contract/ListAvailableModels.js": ["dist/ws-contract/ListAvailableModels.d.ts"],
      "ws-contract/ListLastUsedModelOfSession.js": ["dist/ws-contract/ListLastUsedModelOfSession.d.ts"],
      "ws-contract/RenameSessionOfClient.js": ["dist/ws-contract/RenameSessionOfClient.d.ts"],
      "ws-contract/SelectSession.js": ["dist/ws-contract/SelectSession.d.ts"],
      "ws-contract/ShowToast.js": ["dist/ws-contract/ShowToast.d.ts"],
      "ws-contract/SessionList.js": ["dist/ws-contract/SessionList.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ws-contract/AbortSessionOfClient.js": {
      "types": "./dist/ws-contract/AbortSessionOfClient.d.ts",
      "default": "./dist/ws-contract/AbortSessionOfClient.js"
    },
    "./ws-contract/AddPromot.js": {
      "types": "./dist/ws-contract/AddPromot.d.ts",
      "default": "./dist/ws-contract/AddPromot.js"
    },
    "./ws-contract/CurrentClient.js": {
      "types": "./dist/ws-contract/CurrentClient.d.ts",
      "default": "./dist/ws-contract/CurrentClient.js"
    },
    "./ws-contract/GetSessionMsg.js": {
      "types": "./dist/ws-contract/GetSessionMsg.d.ts",
      "default": "./dist/ws-contract/GetSessionMsg.js"
    },
    "./ws-contract/ListAvailableModels.js": {
      "types": "./dist/ws-contract/ListAvailableModels.d.ts",
      "default": "./dist/ws-contract/ListAvailableModels.js"
    },
    "./ws-contract/ListLastUsedModelOfSession.js": {
      "types": "./dist/ws-contract/ListLastUsedModelOfSession.d.ts",
      "default": "./dist/ws-contract/ListLastUsedModelOfSession.js"
    },
    "./ws-contract/RenameSessionOfClient.js": {
      "types": "./dist/ws-contract/RenameSessionOfClient.d.ts",
      "default": "./dist/ws-contract/RenameSessionOfClient.js"
    },
    "./ws-contract/SelectSession.js": {
      "types": "./dist/ws-contract/SelectSession.d.ts",
      "default": "./dist/ws-contract/SelectSession.js"
    },
    "./ws-contract/ShowToast.js": {
      "types": "./dist/ws-contract/ShowToast.d.ts",
      "default": "./dist/ws-contract/ShowToast.js"
    },
    "./ws-contract/SessionList.js": {
      "types": "./dist/ws-contract/SessionList.d.ts",
      "default": "./dist/ws-contract/SessionList.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
