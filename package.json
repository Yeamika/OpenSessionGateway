{
  "name": "opensessiongateway-workspace",
  "private": true,
  "workspaces": [
    "packages/protocol-library",
    "packages/client-library",
    "packages/client-opencode-plugin-v2",
    "packages/client-template",
    "server",
    "web"
  ],
  "dependencies": {
    "@koishijs/core": "^4.18.11",
    "@koishijs/plugin-adapter-lark": "^3.12.4",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@opensessiongateway/server-plugin-sdk": "0.0.1",
    "koishi": "^4.18.11"
  },
  "scripts": {
    "build:all": "npm --prefix agents/opencode-plug run build && npm --prefix agents/serverplug-core run build:sdk && npm --prefix agents/server run build && npm --prefix agents/web run build",
    "build:protocol": "npm --prefix agents/opencode-plug run build:library",
    "build:client-library": "npm --prefix agents/opencode-plug run build:library",
    "build:server-plugin-sdk": "npm --prefix agents/serverplug-core run build:sdk",
    "build:plugin": "npm --prefix agents/opencode-plug run build:plugin",
    "build:server": "npm --prefix agents/server run build",
    "build:web": "npm --prefix agents/web run build"
  }
}
